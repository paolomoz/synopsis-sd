  {
   "section": "textcomp",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Industry’s Highest Performance Simulation Solution"
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "row",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "Industry-leading performance and capacity"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Compile time: Partition compile, Precompiled IP, Dynamic Reconfiguration"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Runtime: Dynamic Test Loading, Save/Restore, Constraint Solver optimization, Fine-Grained Parallelism"
    },
    {
     "role": "body",
     "order": 3,
     "text": "Advanced simulation technologies"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Native Low Power, Xpropagation, Direct Interfaces (DKI, DPI) to High-Level Modeling (SystemC, ®) and AMS simulation"
    },
    {
     "role": "cta",
     "order": 5,
     "text": "MATLAB",
     "href": "https://www.synopsys.com/verification/simulation/vcs/vcs-matlab.html"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Functional Verification Quality Analysis with Testbench Quality Assurance functional qualification system"
    },
    {
     "role": "body",
     "order": 7,
     "text": "Dynamic SDC-aware verification with Multi Cycle Path and False Path verification"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Dynamic Metastability Injection verification"
    },
    {
     "role": "body",
     "order": 9,
     "text": "Intelligent Coverage Optimization"
    },
    {
     "role": "body",
     "order": 10,
     "text": "Dynamic Performance Optimization"
    },
    {
     "role": "body",
     "order": 11,
     "text": "Testbench coverage - line coverage on testbench classes helps assess testbench quality"
    },
    {
     "role": "body",
     "order": 12,
     "text": "Simulation acceleration with ZeBu® emulation system to provide higher performance"
    },
    {
     "role": "body",
     "order": 13,
     "text": "Comprehensive planning, coverage and execution management native integration"
    },
    {
     "role": "body",
     "order": 14,
     "text": "VCS provides key turnaround time and ease-of-use benefits via native integration with Synopsys Verdi, VC Formal™, Verdi VMS and Verification IP."
    }
   ],
